# optional — URL of the StudioFlow API (default http://localhost:4000)
# VITE_API_URL=http://localhost:4000

# optional — shows the "Sign in with Google" button. Same OAuth client id as GOOGLE_CLIENT_ID in
# backend/.env (Google Cloud console > Google Auth Platform > Clients, type "Web application",
# authorized JavaScript origin http://localhost:5173). It is public, not a secret.
# VITE_GOOGLE_CLIENT_ID=
