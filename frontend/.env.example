# optional — URL of the StudioFlow API (default http://localhost:4000)
# VITE_API_URL=http://localhost:4000

# optional — OAuth client id used by the "Sign in with Google" button. Defaults to our Google app's
# id (src/constants.js); set your own here, or an empty value to hide the button. It must match
# GOOGLE_CLIENT_ID in backend/.env. A client id is public, not a secret.
# VITE_GOOGLE_CLIENT_ID=
