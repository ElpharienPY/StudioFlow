PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=studioflow
DB_PASSWORD=studioflow
DB_NAME=studioflow

# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# comma-separated list of front-end origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# optional — OAuth client id accepted by POST /auth/google. Defaults to our Google app's id
# (src/config/env.js); set your own, or an empty value to disable Google sign-in (501).
# GOOGLE_CLIENT_ID=

# optional — database used by `npm test`, recreated at every run (default: DB_NAME + "_test")
# TEST_DB_NAME=studioflow_test

# optional — max login/signup attempts per IP per 15 min (default 20)
# AUTH_RATE_LIMIT_MAX=20

# optional — "production" turns on secure cookies and makes db:init / db:seed refuse to run (default development)
# NODE_ENV=development
